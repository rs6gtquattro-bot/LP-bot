<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Логи - lpBot</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>📋 Системные логи</h1>
            <div class="network-statuses">
                <div class="status-badge" id="tgBadge" title="Telegram Client">
                    <span class="status-indicator connected" id="tgStatusIndicator"></span>
                    <span id="tgStatusText">TG: Активен</span>
                </div>
                <div class="status-badge" id="vkBadge" title="VK Client & Tunnel">
                    <span class="status-indicator state-disabled" id="vkStatusIndicator"></span>
                    <span id="vkStatusText">VK: Не настроен</span>
                </div>
            </div>
        </header>

        <nav class="sidebar">
            <ul>
                <li><a href="/">📊 Главная</a></li>
                <li><a href="/settings">⚙️ Настройки</a></li>
                <li><a href="/triggers">🔔 Триггеры</a></li>
                <li><a href="/templates">📁 Шаблоны</a></li>
                <li><a href="/commands">🎯 Команды</a></li>
                <li><a href="/deepseek">🤖 DeepSeek</a></li>
                <li><a href="/logs" class="active">📋 Логи</a></li>
                <li><a href="/stats">📈 Статистика</a></li>
                <li><a href="/export">💾 Экспорт</a></li>
            </ul>
        </nav>

        <main class="content">
            <div class="card">
                <h3>🔧 Управление логами</h3>
                <div class="logs-controls">
                    <div class="control-group">
                        <button onclick="refreshLogs()" class="btn primary">🔄 Обновить</button>
                        <button onclick="clearLogs()" class="btn secondary">🗑️ Очистить логи</button>
                        <button onclick="downloadLogs()" class="btn tertiary">📥 Скачать логи</button>
                    </div>
                    
                    <div class="control-group">
                        <label for="logLevel">Уровень логирования:</label>
                        <select id="logLevel" onchange="filterLogs()" class="form-control">
                            <option value="all">Все уровни</option>
                            <option value="info">📝 Info</option>
                            <option value="warn">⚠️ Warning</option>
                            <option value="error">❌ Error</option>
                            <option value="debug">🔧 Debug</option>
                        </select>
                    </div>

                    <div class="control-group">
                        <label for="autoRefresh">Автообновление:</label>
                        <label class="checkbox-label">
                            <input type="checkbox" id="autoRefresh" onchange="toggleAutoRefresh()">
                            <span class="checkmark"></span>
                            Включить (каждые 10 сек)
                        </label>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>📊 Статистика логов</h3>
                <div class="logs-stats">
                    <div class="log-stat">
                        <span class="stat-label">Всего записей:</span>
                        <span class="stat-value" id="totalLogs">0</span>
                    </div>
                    <div class="log-stat">
                        <span class="stat-label">Info:</span>
                        <span class="stat-value info" id="infoLogs">0</span>
                    </div>
                    <div class="log-stat">
                        <span class="stat-label">Warnings:</span>
                        <span class="stat-value warn" id="warnLogs">0</span>
                    </div>
                    <div class="log-stat">
                        <span class="stat-label">Errors:</span>
                        <span class="stat-value error" id="errorLogs">0</span>
                    </div>
                    <div class="log-stat">
                        <span class="stat-label">Debug:</span>
                        <span class="stat-value debug" id="debugLogs">0</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>📝 Журнал событий</h3>
                <div class="logs-container">
                    <div id="logsList" class="logs-list">
                        <div class="loading-logs">🔄 Загрузка логов...</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>🔍 Поиск по логам</h3>
                <div class="search-controls">
                    <input type="text" id="logSearch" class="form-control" 
                           placeholder="Введите текст для поиска в логах...">
                    <button onclick="searchLogs()" class="btn primary">🔍 Поиск</button>
                </div>
                <div id="searchResults" class="search-results" style="display: none;"></div>
            </div>
        </main>
    </div>

    <script src="/js/app.js"></script>
    <script>
    let autoRefreshInterval = null;
    let allLogs = [];

    // Загрузка логов при открытии страницы
    document.addEventListener('DOMContentLoaded', loadLogs);

    async function loadLogs() {
        const logsList = document.getElementById('logsList');
        try {
            const response = await fetch('/api/logs');
            const data = await response.json();
            allLogs = data.logs || [];
            displayLogs(allLogs);
            updateStats(allLogs);
        } catch (error) {
            console.error('Ошибка загрузки логов:', error);
            logsList.replaceChildren();
            const errDiv = document.createElement('div');
            errDiv.className = 'error-message';
            errDiv.textContent = '❌ Ошибка загрузки логов';
            logsList.appendChild(errDiv);
        }
    }

    // Безопасный рендеринг строго через DOM API и textContent
    function displayLogs(logs) {
        const logsList = document.getElementById('logsList');
        logsList.replaceChildren();
        
        if (logs.length === 0) {
            const emptyDiv = document.createElement('div');
            emptyDiv.className = 'no-logs';
            emptyDiv.textContent = '📭 Логи отсутствуют';
            logsList.appendChild(emptyDiv);
            return;
        }

        logs.forEach(log => {
            const entry = document.createElement('div');
            entry.className = `log-entry log-${log.level || 'info'}`;

            const timeDiv = document.createElement('div');
            timeDiv.className = 'log-time';
            timeDiv.textContent = formatTime(log.time);

            const levelDiv = document.createElement('div');
            levelDiv.className = 'log-level';
            levelDiv.textContent = `${getLevelIcon(log.level)} ${String(log.level || '').toUpperCase()}`;

            const msgDiv = document.createElement('div');
            msgDiv.className = 'log-message';
            msgDiv.textContent = String(log.message || '');

            entry.appendChild(timeDiv);
            entry.appendChild(levelDiv);
            entry.appendChild(msgDiv);

            logsList.appendChild(entry);
        });

        logsList.scrollTop = logsList.scrollHeight;
    }

    function formatTime(timeString) {
        if (!timeString) return '';
        const date = new Date(timeString);
        return isNaN(date.getTime()) ? String(timeString) : date.toLocaleString('ru-RU');
    }

    function getLevelIcon(level) {
        const icons = {
            'info': '📝',
            'warn': '⚠️',
            'error': '❌',
            'debug': '🔧'
        };
        return icons[level] || '📄';
    }

    function updateStats(logs) {
        document.getElementById('totalLogs').textContent = logs.length;
        document.getElementById('infoLogs').textContent = logs.filter(l => l.level === 'info').length;
        document.getElementById('warnLogs').textContent = logs.filter(l => l.level === 'warn').length;
        document.getElementById('errorLogs').textContent = logs.filter(l => l.level === 'error').length;
        document.getElementById('debugLogs').textContent = logs.filter(l => l.level === 'debug').length;
    }

    function filterLogs() {
        const level = document.getElementById('logLevel').value;
        let filteredLogs = allLogs;

        if (level !== 'all') {
            filteredLogs = allLogs.filter(log => log.level === level);
        }

        displayLogs(filteredLogs);
    }

    function refreshLogs() {
        loadLogs();
        if (window.dashboard) {
            dashboard.showNotification('Логи обновлены', 'success');
        }
    }

    function clearLogs() {
        if (confirm('Очистить все логи?')) {
            fetch('/api/logs', { method: 'DELETE' }).catch(() => {});
            allLogs = [];
            displayLogs([]);
            updateStats([]);
            if (window.dashboard) {
                dashboard.showNotification('Логи очищены', 'success');
            }
        }
    }

    function downloadLogs() {
        if (allLogs.length === 0) {
            if (window.dashboard) dashboard.showNotification('Нет логов для скачивания', 'warning');
            return;
        }

        const logText = allLogs.map(log => 
            `[${formatTime(log.time)}] ${String(log.level || '').toUpperCase()}: ${log.message}`
        ).join('\n');

        const blob = new Blob([logText], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `lpbot-logs-${new Date().toISOString().split('T')[0]}.txt`;
        a.click();
        URL.revokeObjectURL(url);
        
        if (window.dashboard) dashboard.showNotification('Логи скачаны', 'success');
    }

    function toggleAutoRefresh() {
        const autoRefresh = document.getElementById('autoRefresh');
        
        if (autoRefresh.checked) {
            autoRefreshInterval = setInterval(refreshLogs, 10000);
            if (window.dashboard) dashboard.showNotification('Автообновление включено', 'success');
        } else {
            clearInterval(autoRefreshInterval);
            autoRefreshInterval = null;
            if (window.dashboard) dashboard.showNotification('Автообновление выключено', 'info');
        }
    }

    // Безопасный поиск с подсветкой без innerHTML (через текстовые узлы и элементы <mark>)
    function appendHighlightedText(container, text, term) {
        if (!term) {
            container.textContent = text;
            return;
        }
        const lowerText = text.toLowerCase();
        const lowerTerm = term.toLowerCase();
        let startIndex = 0;
        let matchIndex = lowerText.indexOf(lowerTerm, startIndex);

        if (matchIndex === -1) {
            container.textContent = text;
            return;
        }

        while (matchIndex !== -1) {
            if (matchIndex > startIndex) {
                container.appendChild(document.createTextNode(text.slice(startIndex, matchIndex)));
            }
            const mark = document.createElement('mark');
            mark.textContent = text.slice(matchIndex, matchIndex + term.length);
            container.appendChild(mark);

            startIndex = matchIndex + term.length;
            matchIndex = lowerText.indexOf(lowerTerm, startIndex);
        }

        if (startIndex < text.length) {
            container.appendChild(document.createTextNode(text.slice(startIndex)));
        }
    }

    function searchLogs() {
        const searchTerm = document.getElementById('logSearch').value.trim();
        const resultsContainer = document.getElementById('searchResults');
        resultsContainer.replaceChildren();

        if (!searchTerm) {
            resultsContainer.style.display = 'none';
            return;
        }

        const lowerTerm = searchTerm.toLowerCase();
        const results = allLogs.filter(log => 
            String(log.message || '').toLowerCase().includes(lowerTerm) ||
            String(log.level || '').toLowerCase().includes(lowerTerm)
        );

        if (results.length === 0) {
            const noRes = document.createElement('div');
            noRes.className = 'no-results';
            noRes.textContent = '🔍 Совпадений не найдено';
            resultsContainer.appendChild(noRes);
        } else {
            const heading = document.createElement('h4');
            heading.textContent = `Найдено совпадений: ${results.length}`;
            resultsContainer.appendChild(heading);

            results.forEach(log => {
                const entry = document.createElement('div');
                entry.className = `log-entry log-${log.level || 'info'}`;

                const timeDiv = document.createElement('div');
                timeDiv.className = 'log-time';
                timeDiv.textContent = formatTime(log.time);

                const levelDiv = document.createElement('div');
                levelDiv.className = 'log-level';
                levelDiv.textContent = `${getLevelIcon(log.level)} ${String(log.level || '').toUpperCase()}`;

                const msgDiv = document.createElement('div');
                msgDiv.className = 'log-message';
                appendHighlightedText(msgDiv, String(log.message || ''), searchTerm);

                entry.appendChild(timeDiv);
                entry.appendChild(levelDiv);
                entry.appendChild(msgDiv);

                resultsContainer.appendChild(entry);
            });
        }
        
        resultsContainer.style.display = 'block';
    }

    // Загрузка логов каждые 30 секунд при включенном автообновлении
    setInterval(() => {
        if (document.getElementById('autoRefresh')?.checked) {
            loadLogs();
        }
    }, 30000);
    </script>
</body>
</html>
