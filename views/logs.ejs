<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Логи - lpBot</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>📋 Системные логи</h1>
            <div class="status">
                <span class="status-indicator connected"></span>
                <span>Бот активен</span>
            </div>
        </header>

        <nav class="sidebar">
            <ul>
                <li><a href="/">📊 Главная</a></li>
                <li><a href="/settings">⚙️ Настройки</a></li>
                <li><a href="/triggers">🔔 Триггеры</a></li>
                <li><a href="/templates">📁 Шаблоны</a></li>
                <li><a href="/commands">🎯 Команды</a></li>
                <li><a href="/deepseek">🤖 DeepSeek</a></li>
                <li><a href="/logs" class="active">📋 Логи</a></li>
                <li><a href="/stats">📈 Статистика</a></li>
                <li><a href="/export">💾 Экспорт</a></li>
            </ul>
        </nav>

        <main class="content">
            <div class="card">
                <h3>🔧 Управление логами</h3>
                <div class="logs-controls">
                    <div class="control-group">
                        <button onclick="refreshLogs()" class="btn primary">🔄 Обновить</button>
                        <button onclick="clearLogs()" class="btn secondary">🗑️ Очистить логи</button>
                        <button onclick="downloadLogs()" class="btn tertiary">📥 Скачать логи</button>
                    </div>
                    
                    <div class="control-group">
                        <label for="logLevel">Уровень логирования:</label>
                        <select id="logLevel" onchange="filterLogs()" class="form-control">
                            <option value="all">Все уровни</option>
                            <option value="info">📝 Info</option>
                            <option value="warn">⚠️ Warning</option>
                            <option value="error">❌ Error</option>
                            <option value="debug">🔧 Debug</option>
                        </select>
                    </div>

                    <div class="control-group">
                        <label for="autoRefresh">Автообновление:</label>
                        <label class="checkbox-label">
                            <input type="checkbox" id="autoRefresh" onchange="toggleAutoRefresh()">
                            <span class="checkmark"></span>
                            Включить (каждые 10 сек)
                        </label>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>📊 Статистика логов</h3>
                <div class="logs-stats">
                    <div class="log-stat">
                        <span class="stat-label">Всего записей:</span>
                        <span class="stat-value" id="totalLogs">0</span>
                    </div>
                    <div class="log-stat">
                        <span class="stat-label">Info:</span>
                        <span class="stat-value info" id="infoLogs">0</span>
                    </div>
                    <div class="log-stat">
                        <span class="stat-label">Warnings:</span>
                        <span class="stat-value warn" id="warnLogs">0</span>
                    </div>
                    <div class="log-stat">
                        <span class="stat-label">Errors:</span>
                        <span class="stat-value error" id="errorLogs">0</span>
                    </div>
                    <div class="log-stat">
                        <span class="stat-label">Debug:</span>
                        <span class="stat-value debug" id="debugLogs">0</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>📝 Журнал событий</h3>
                <div class="logs-container">
                    <div id="logsList" class="logs-list">
                        <div class="loading-logs">🔄 Загрузка логов...</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>🔍 Поиск по логам</h3>
                <div class="search-controls">
                    <input type="text" id="logSearch" class="form-control" 
                           placeholder="Введите текст для поиска в логах...">
                    <button onclick="searchLogs()" class="btn primary">🔍 Поиск</button>
                </div>
                <div id="searchResults" class="search-results" style="display: none;"></div>
            </div>
        </main>
    </div>

    <script src="/js/app.js"></script>
    <script>
    let autoRefreshInterval = null;
    let allLogs = [];

    // Загрузка логов при открытии страницы
    document.addEventListener('DOMContentLoaded', loadLogs);

    async function loadLogs() {
        try {
            const response = await fetch('/api/logs');
            const data = await response.json();
            allLogs = data.logs || [];
            displayLogs(allLogs);
            updateStats(allLogs);
        } catch (error) {
            console.error('Ошибка загрузки логов:', error);
            document.getElementById('logsList').innerHTML = 
                '<div class="error-message">❌ Ошибка загрузки логов</div>';
        }
    }

    function displayLogs(logs) {
        const logsList = document.getElementById('logsList');
        
        if (logs.length === 0) {
            logsList.innerHTML = '<div class="no-logs">📭 Логи отсутствуют</div>';
            return;
        }

        logsList.innerHTML = logs.map(log => `
            <div class="log-entry log-${log.level}">
                <div class="log-time">${formatTime(log.time)}</div>
                <div class="log-level">${getLevelIcon(log.level)} ${log.level.toUpperCase()}</div>
                <div class="log-message">${log.message}</div>
            </div>
        `).join('');

        // Прокрутка к самым новым логам
        logsList.scrollTop = logsList.scrollHeight;
    }

    function formatTime(timeString) {
        const date = new Date(timeString);
        return date.toLocaleString('ru-RU');
    }

    function getLevelIcon(level) {
        const icons = {
            'info': '📝',
            'warn': '⚠️',
            'error': '❌',
            'debug': '🔧'
        };
        return icons[level] || '📄';
    }

    function updateStats(logs) {
        document.getElementById('totalLogs').textContent = logs.length;
        document.getElementById('infoLogs').textContent = logs.filter(l => l.level === 'info').length;
        document.getElementById('warnLogs').textContent = logs.filter(l => l.level === 'warn').length;
        document.getElementById('errorLogs').textContent = logs.filter(l => l.level === 'error').length;
        document.getElementById('debugLogs').textContent = logs.filter(l => l.level === 'debug').length;
    }

    function filterLogs() {
        const level = document.getElementById('logLevel').value;
        let filteredLogs = allLogs;

        if (level !== 'all') {
            filteredLogs = allLogs.filter(log => log.level === level);
        }

        displayLogs(filteredLogs);
    }

    function refreshLogs() {
        loadLogs();
        dashboard.showNotification('Логи обновлены', 'success');
    }

    function clearLogs() {
        if (confirm('Очистить все логи?')) {
            fetch('/api/logs', { method: 'DELETE' }).catch(() => {});
            allLogs = [];
            displayLogs([]);
            updateStats([]);
            dashboard.showNotification('Логи очищены', 'success');
        }
    }

    function downloadLogs() {
        if (allLogs.length === 0) {
            dashboard.showNotification('Нет логов для скачивания', 'warning');
            return;
        }

        const logText = allLogs.map(log => 
            `[${formatTime(log.time)}] ${log.level.toUpperCase()}: ${log.message}`
        ).join('\n');

        const blob = new Blob([logText], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `lpbot-logs-${new Date().toISOString().split('T')[0]}.txt`;
        a.click();
        URL.revokeObjectURL(url);
        
        dashboard.showNotification('Логи скачаны', 'success');
    }

    function toggleAutoRefresh() {
        const autoRefresh = document.getElementById('autoRefresh');
        
        if (autoRefresh.checked) {
            autoRefreshInterval = setInterval(refreshLogs, 10000);
            dashboard.showNotification('Автообновление включено', 'success');
        } else {
            clearInterval(autoRefreshInterval);
            autoRefreshInterval = null;
            dashboard.showNotification('Автообновление выключено', 'info');
        }
    }

    function searchLogs() {
        const searchTerm = document.getElementById('logSearch').value.toLowerCase();
        if (!searchTerm) return;

        const results = allLogs.filter(log => 
            log.message.toLowerCase().includes(searchTerm) ||
            log.level.toLowerCase().includes(searchTerm)
        );

        const resultsContainer = document.getElementById('searchResults');
        
        if (results.length === 0) {
            resultsContainer.innerHTML = '<div class="no-results">🔍 Совпадений не найдено</div>';
        } else {
            resultsContainer.innerHTML = `
                <h4>Найдено совпадений: ${results.length}</h4>
                ${results.map(log => `
                    <div class="log-entry log-${log.level}">
                        <div class="log-time">${formatTime(log.time)}</div>
                        <div class="log-level">${getLevelIcon(log.level)} ${log.level.toUpperCase()}</div>
                        <div class="log-message">${highlightSearchTerm(log.message, searchTerm)}</div>
                    </div>
                `).join('')}
            `;
        }
        
        resultsContainer.style.display = 'block';
    }

    function highlightSearchTerm(text, term) {
        const regex = new RegExp(`(${term})`, 'gi');
        return text.replace(regex, '<mark>$1</mark>');
    }

    // Загрузка логов каждые 30 секунд
    setInterval(() => {
        if (document.getElementById('autoRefresh')?.checked) {
            loadLogs();
        }
    }, 30000);
    </script>

    <style>
    .logs-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: end;
    }

    .control-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .logs-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
    }

    .log-stat {
        background: #f7fafc;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
    }

    .stat-label {
        display: block;
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 0.25rem;
    }

    .stat-value {
        display: block;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .stat-value.info { color: #3182ce; }
    .stat-value.warn { color: #d69e2e; }
    .stat-value.error { color: #e53e3e; }
    .stat-value.debug { color: #805ad5; }

    .logs-container {
        max-height: 500px;
        overflow-y: auto;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fafafa;
    }

    .logs-list {
        padding: 1rem;
    }

    .log-entry {
        display: grid;
        grid-template-columns: 150px 100px 1fr;
        gap: 1rem;
        padding: 0.75rem;
        border-bottom: 1px solid #e2e8f0;
        align-items: center;
        font-family: 'Courier New', monospace;
        font-size: 0.875rem;
    }

    .log-entry:last-child {
        border-bottom: none;
    }

    .log-entry.log-info {
        background: #ebf8ff;
        border-left: 4px solid #3182ce;
    }

    .log-entry.log-warn {
        background: #fef5e7;
        border-left: 4px solid #d69e2e;
    }

    .log-entry.log-error {
        background: #fed7d7;
        border-left: 4px solid #e53e3e;
    }

    .log-entry.log-debug {
        background: #faf5ff;
        border-left: 4px solid #805ad5;
    }

    .log-time {
        color: #6b7280;
        font-size: 0.75rem;
    }

    .log-level {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
    }

    .log-message {
        color: #2d3748;
        word-break: break-word;
    }

    .search-controls {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .search-controls .form-control {
        flex: 1;
    }

    .search-results {
        max-height: 300px;
        overflow-y: auto;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1rem;
        background: #f7fafc;
    }

    .loading-logs,
    .no-logs,
    .error-message {
        text-align: center;
        padding: 2rem;
        color: #6b7280;
    }

    .error-message {
        color: #e53e3e;
    }

    mark {
        background: #fef5e7;
        color: #d69e2e;
        padding: 0.125rem 0.25rem;
        border-radius: 2px;
    }

    @media (max-width: 768px) {
        .logs-controls {
            flex-direction: column;
            align-items: stretch;
        }
        
        .log-entry {
            grid-template-columns: 1fr;
            gap: 0.25rem;
        }
        
        .log-time,
        .log-level {
            font-size: 0.7rem;
        }
        
        .search-controls {
            flex-direction: column;
        }
    }
    </style>
</body>
</html>