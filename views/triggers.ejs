<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Триггеры - lpBot</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>🔔 Управление триггерами</h1>
            <div class="network-statuses">
                <div class="status-badge" id="tgBadge" title="Telegram Client">
                    <span class="status-indicator connected" id="tgStatusIndicator"></span>
                    <span id="tgStatusText">TG: Активен</span>
                </div>
                <div class="status-badge" id="vkBadge" title="VK Client & Tunnel">
                    <span class="status-indicator state-disabled" id="vkStatusIndicator"></span>
                    <span id="vkStatusText">VK: Не настроен</span>
                </div>
            </div>
        </header>

        <nav class="sidebar">
            <ul>
                <li><a href="/">📊 Главная</a></li>
                <li><a href="/settings">⚙️ Настройки</a></li>
                <li><a href="/triggers" class="active">🔔 Триггеры</a></li>
                <li><a href="/templates">📁 Шаблоны</a></li>
                <li><a href="/commands">🎯 Команды</a></li>
                <li><a href="/deepseek">🤖 DeepSeek</a></li>
                <li><a href="/logs">📋 Логи</a></li>
                <li><a href="/stats">📈 Статистика</a></li>
                <li><a href="/export">💾 Экспорт</a></li>
            </ul>
        </nav>

        <main class="content">
            <div class="card">
                <h3>Добавить новый триггер</h3>
                <form id="triggerForm" onsubmit="addTrigger(event)">
                    <div class="form-group">
                        <label for="word">Слово-триггер:</label>
                        <input type="text" id="word" name="word" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="responses">Ответы (разделяйте | для нескольких):</label>
                        <textarea id="responses" name="responses" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="count">Количество повторов:</label>
                            <input type="number" id="count" name="count" class="form-control" value="1" min="1" max="20">
                        </div>
                        <div class="form-group">
                            <label for="chance">Шанс срабатывания (%):</label>
                            <input type="number" id="chance" name="chance" class="form-control" value="100" min="1" max="100">
                        </div>
                    </div>
                    <button type="submit" class="btn primary">Добавить триггер</button>
                </form>
            </div>

            <div class="card">
                <h3>Список триггеров (<span id="triggersCount"><%= total %></span>)</h3>
                <div class="table">
                    <div class="table-header">
                        <div class="table-row">
                            <div>Слово</div>
                            <div>Ответы</div>
                            <div>Действия</div>
                        </div>
                    </div>
                    <div id="triggersContainer">
                        <% triggers.forEach(trigger => { %>
                            <div class="table-row">
                                <div class="trigger-word"><%= trigger.word %></div>
                                <div class="trigger-responses"><%= trigger.responses.slice(0, 2).join(', ') %></div>
                                <div class="trigger-actions">
                                    <button data-word="<%= trigger.word %>" onclick="deleteTrigger(this.dataset.word)" class="btn danger">Удалить</button>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/app.js"></script>
    <script>
    async function addTrigger(event) {
        event.preventDefault();
        const formData = new FormData(event.target);
        const data = Object.fromEntries(formData);
        
        // Преобразуем responses в массив
        data.responses = data.responses.split('|').map(r => r.trim()).filter(r => r);
        
        try {
            const response = await fetch('/triggers', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            
            if (result.success) {
                dashboard.showNotification('Триггер добавлен', 'success');
                event.target.reset();
                dashboard.loadTriggers();
            } else {
                dashboard.showNotification(result.message, 'error');
            }
        } catch (error) {
            dashboard.showNotification('Ошибка добавления триггера', 'error');
        }
    }
    </script>
</body>
</html>