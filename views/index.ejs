<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>lpBot Control Panel</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>🤖 lpBot Control Panel</h1>
            <div class="status" id="status">
                <span class="status-indicator" id="statusIndicator"></span>
                <span id="statusText">Загрузка...</span>
            </div>
        </header>

        <nav class="sidebar">
            <ul>
                <li><a href="/" class="active">📊 Главная</a></li>
                <li><a href="/settings">⚙️ Настройки</a></li>
                <li><a href="/triggers">🔔 Триггеры</a></li>
                <li><a href="/templates">📁 Шаблоны</a></li>
                <li><a href="/commands">🎯 Команды</a></li>
                <li><a href="/deepseek">🤖 DeepSeek</a></li>
                <li><a href="/logs">📋 Логи</a></li>
                <li><a href="/stats">📈 Статистика</a></li>
                <li><a href="/export">💾 Экспорт</a></li>
            </ul>
        </nav>

        <main class="content">
            <div class="dashboard">
                <div class="card">
                    <h3>📊 Статус бота</h3>
                    <div class="stats">
                        <div class="stat">
                            <span class="label">Состояние:</span>
                            <span class="value" id="botStatus">-</span>
                        </div>
                        <div class="stat">
                            <span class="label">Аптайм:</span>
                            <span class="value" id="uptime">-</span>
                        </div>
                        <div class="stat">
                            <span class="label">Память:</span>
                            <span class="value" id="memory">-</span>
                        </div>
                        <div class="stat">
                            <span class="label">Триггеры:</span>
                            <span class="value" id="triggersCount">-</span>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <h3>🔗 Соединение</h3>
                    <div class="stats">
                        <div class="stat">
                            <span class="label">Telegram:</span>
                            <span class="value" id="telegramStatus">-</span>
                        </div>
                        <div class="stat">
                            <span class="label">Пользователь:</span>
                            <span class="value" id="botUser">-</span>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <h3>🎯 Быстрые действия</h3>
                    <div class="actions">
                        <button onclick="location.href='/triggers'" class="btn primary">Управление триггерами</button>
                        <button onclick="location.href='/settings'" class="btn secondary">Настройки</button>
                        <button onclick="location.href='/logs'" class="btn tertiary">Просмотр логов</button>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>